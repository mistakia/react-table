@import '../styles/tokens.styl'
@import '../styles/column-category.styl'
@import '../styles/search-input.styl'
@import '../styles/popper-surface.styl'

.table-column-controls
  width var(--rt-slot-columns-width)
  left var(--rt-slot-columns-left)

  .column-drag-handle
    display flex
    align-items center
    justify-content center
    cursor ns-resize
    color $rt_text_subtle

.selected-columns-container
  padding $rt_space_sm
  display flex
  gap $rt_space_xs
  flex-direction column

  .column-actions
    display flex
    align-items center

  .column-item-slot
    width 32px
    display flex
    align-items center
    justify-content center
    flex 0 0 32px

  .column-item-action
    color $rt_text_muted
    padding 4px
    &.Mui-disabled
      color $rt_text_disabled
      opacity 0.35
    &:hover
      background $rt_button_hover_bg
      color $rt_text

  .column-item-remove:hover
    color #c0392b
    background rgba(192, 57, 43, 0.08)

  .column-item-bulk-checkbox
    padding 4px
    &.Mui-disabled
      opacity 0.35

  .column-drag-handle
    width 32px
    flex 0 0 32px

  .column-name-funnel
    margin-left $rt_space_xs
    font-size 14px
    color $rt_text_subtle
    vertical-align middle

.column-controls-body
  overflow-y scroll
  height 100%
  flex 1

.table-column-controls-load-all-columns
  margin $rt_space_sm
  padding $rt_space_sm $rt_space_lg
  border-radius $rt_radius_sm
  background $rt_bg_hover
  cursor pointer
  border 1px solid transparent
  display flex
  align-items center
  justify-content center
  color $rt_text_muted
  font-size $rt_font_size_sm
  transition border-color $rt_transition, background $rt_transition
  &:hover
    border 1px solid $rt_border
    background $rt_bg_hover_strong
    color $rt_text

.column-category-container
  padding $rt_space_sm
  margin-bottom $rt_space_sm
  display flex
  flex-direction column
  overflow-y auto

  .column-category
    cursor pointer

@media (pointer: fine)
  .column-category-container
    .column-category
      &:hover
        background $rt_bg_hover

.column-controls-query-backed-notice
  padding $rt_space_sm
  margin $rt_space_sm
  border 1px solid $rt_border
  border-radius 3px
  background $rt_bg_hover
  color $rt_text_muted
  font-size 12px
  line-height 1.4

// THE EMPTY-VIEW CUE. A table with no columns has one next step and five
// identical grey words in its control strip, so the one that takes the step
// says so.
//
// THREE PULSES, THEN A STEADY COLOUR, and the pair is the whole design: an
// animation that never stops stops reading as an invitation and starts reading
// as an error indicator, while one that leaves nothing behind is missed
// entirely by anyone who looked away for two seconds. The class comes off the
// moment a column is committed, so the pulses replay if the view is emptied
// again.
.table-column-controls.-attention:not(.-open)
  .table-expanding-control-button
    color $rt_accent_text
    animation rt_column_controls_attention 1600ms ease-in-out 3

    // Restated because this block outranks the base button's own :hover, and a
    // control that does not answer the pointer reads as decoration.
    &:hover
      color $rt_accent

@keyframes rt_column_controls_attention
  0%
    box-shadow 0 0 0 0 $rt_accent_subtle
  50%
    box-shadow 0 0 0 6px $rt_accent_subtle
  100%
    box-shadow 0 0 0 0 $rt_accent_subtle

// The steady colour still carries the cue without motion, so nothing is lost
// for a reader who has asked the OS not to animate.
@media (prefers-reduced-motion: reduce)
  .table-column-controls.-attention:not(.-open)
    .table-expanding-control-button
      animation none
