@import '../styles/tokens.styl'

// Sits inside the sticky header, so it inherits the header's uppercase, heavy
// type. A row of numbers set like column titles reads as more headers, so it
// is set back to body type and muted to read as reference, not data.
.table .header .row.average-row
  height 24px
  font-size 12px
  font-weight 400
  letter-spacing normal
  text-transform none
  font-style italic
  color $rt_text_muted

  .cell:not(.column-index)
    border-bottom 1px solid $rt_border_subtle

  .average-row-label
    justify-content flex-start
    font-weight 600

  // The header row's fixed 24px height makes .cell-content's height:100% sit
  // at exactly the full cell, so its text tops-out at the cell's top edge. Put
  // the content on a centered flex line, like .cell.column-index already does.
  .cell-content
    display flex
    align-items center
