@import '../styles/tokens.styl'

.override-section
  flex 1
  min-width 0
  display flex
  flex-direction column
  border-top 1px solid rt_fade($rt_contrast_pole, 12)

  .override-header
    display flex
    align-items center
    justify-content space-between
    padding 8px
    flex-shrink 0
    border-bottom 1px solid rt_fade($rt_contrast_pole, 12)

    .override-label
      font-size 12px
      font-weight 500
      text-transform uppercase
      color rt_fade($rt_contrast_pole, 54)
      flex 1

  .override-params-body
    flex 1
    min-height 0
    overflow-y auto
    padding 8px
    background rt_soften($rt_contrast_pole, 96)

  .override-params-search
    padding 0 0 8px

  .override-params-container
    display flex
    flex-wrap wrap
