@import './tokens.styl'

// The lib's shared button treatments. A component that needs a button reaches
// for one of these rather than restating padding, radius, border and hover --
// see STYLE.md § Buttons for the three patterns and why none of them carries a
// chromatic fill.
//
// Tokens are imported explicitly rather than relied on from the ambient stylus
// `import` option, because a consumer compiling these sources injects ITS OWN
// variables file into every stylesheet. league's $box_shadow, for instance, is
// a hard 4px offset and nothing like $rt_shadow_overlay.

// Toolbar / ghost. The resting state is invisible and hover reveals the border
// and background -- the same treatment the column and filter control triggers
// present, which is what makes a button dropped beside them read as one of the
// set.
.rt-button
  display inline-flex
  align-items center
  justify-content center
  gap $rt_space_xs
  height 32px
  padding 0 $rt_space_sm
  border 1px solid transparent
  border-radius $rt_radius_sm
  background-color transparent
  color $rt_text
  font-family inherit
  font-size $rt_font_size
  font-weight $rt_font_weight_label
  line-height 1
  white-space nowrap
  cursor pointer
  transition color $rt_transition, background-color $rt_transition, border-color $rt_transition

  &:hover
    border-color $rt_border
    background-color $rt_bg_hover

  &:disabled
    cursor default
    color $rt_text_disabled

    &:hover
      border-color transparent
      background-color transparent

// A leading glyph. Sized off the label rather than the icon so it aligns on the
// text baseline box, and marked aria-hidden at the call site -- the label
// already says what the button does.
.rt-button-glyph
  font-size $rt_font_size_md
  line-height 1

// Panel-footer actions (Discard / Apply). Left on the ambient $box_shadow on
// purpose: consumers define that variable themselves and league's is a hard
// offset that this control has always rendered with.
.controls-button
  padding 0.25rem 0.5rem
  border-radius 3px
  display flex
  justify-content center
  align-items center
  font-weight 600
  cursor pointer
  &:hover
    box-shadow $box_shadow
