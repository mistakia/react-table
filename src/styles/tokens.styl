// react-table design tokens.
// See STYLE.md for the contract. Defaults below match the existing visual
// identity established by table-column-controls and table-filter-controls.
// Consumers override by redefining the --rt-* CSS custom properties on :root
// (or any ancestor scope).

// Stylus mirrors. A colour mirror resolves to its runtime custom property, so a
// consumer's :root override reaches every component -- that is what lets a host
// theme the table. Sizes, spacing and layers stay build-time values.
$rt_border = var(--rt-border)
$rt_border_subtle = var(--rt-border-subtle)
$rt_divider = var(--rt-divider)
$rt_bg = var(--rt-bg)
$rt_bg_subtle = var(--rt-bg-subtle)
$rt_bg_hover = var(--rt-bg-hover)
$rt_bg_hover_strong = var(--rt-bg-hover-strong)
$rt_bg_selected = var(--rt-bg-selected)
$rt_bg_overlay = var(--rt-bg-overlay)
$rt_text = var(--rt-text)
$rt_text_muted = var(--rt-text-muted)
$rt_text_subtle = var(--rt-text-subtle)
$rt_text_disabled = var(--rt-text-disabled)
$rt_accent = var(--rt-accent)
$rt_accent_strong = var(--rt-accent-strong)
$rt_accent_subtle = var(--rt-accent-subtle)
$rt_accent_text = var(--rt-accent-text)
$rt_success = var(--rt-success)
$rt_success_strong = var(--rt-success-strong)
$rt_success_bg = var(--rt-success-bg)
$rt_active_bg = var(--rt-active-bg)
$rt_active_bar = var(--rt-active-bar)
$rt_destructive = var(--rt-destructive)
$rt_destructive_subtle = var(--rt-destructive-subtle)
$rt_destructive_strong = var(--rt-destructive-strong)
$rt_contrast_pole = var(--rt-contrast-pole)
$rt_shade = var(--rt-shade)
$rt_on_fill = var(--rt-on-fill)
$rt_selection = var(--rt-selection)
$rt_caution = var(--rt-caution)
$rt_caution_strong = var(--rt-caution-strong)
$rt_remove = var(--rt-remove)
$rt_menu_ink = var(--rt-menu-ink)
$rt_state_chip = var(--rt-state-chip)
$rt_sorted_bg = var(--rt-sorted-bg)
$rt_cell_hover = var(--rt-cell-hover)
$rt_resizer_hover = var(--rt-resizer-hover)
$rt_button_bg = var(--rt-button-bg)
$rt_button_border = var(--rt-button-border)
$rt_info_bg = var(--rt-info-bg)
$rt_info_text = var(--rt-info-text)
$rt_info_border = var(--rt-info-border)
$rt_control_bg = var(--rt-control-bg)
$rt_control_border = var(--rt-control-border)
$rt_chip_border = var(--rt-chip-border)
$rt_chip_selected = var(--rt-chip-selected)
$rt_label_text = var(--rt-label-text)

// A colour mirror is a runtime value, so stylus's colour functions cannot run
// on it. Derive with these, which emit color-mix() and so follow a host's
// override: rt_fade() is the colour at an opacity (rgba() on a token), and
// rt_soften() moves it toward the table surface (lighten() in the default
// theme). Amounts are percentages.
rt_fade(color, opacity)
  unquote('color-mix(in srgb, ' + color + ' ' + opacity + '%, transparent)')

rt_soften(color, amount)
  unquote('color-mix(in srgb, ' + color + ' ' + (100 - amount) + '%, var(--rt-bg))')

$rt_radius_sm = 4px
$rt_radius = 6px
$rt_radius_lg = 8px
$rt_font_size_micro = 11px
$rt_font_size_sm = 12px
$rt_font_size = 13px
$rt_font_size_md = 14px
$rt_font_weight_label = 600
$rt_space_xs = 4px
$rt_space_sm = 8px
$rt_space = 12px
$rt_space_lg = 16px
$rt_space_xl = 20px
$rt_row_height = 28px
$rt_row_padding_y = 6px
$rt_focus_ring = var(--rt-focus-ring)
$rt_shadow_overlay = var(--rt-shadow-overlay)
$rt_modal_border = var(--rt-modal-border)
$rt_modal_shadow = var(--rt-modal-shadow)
$rt_button_hover_bg = var(--rt-button-hover-bg)
$rt_button_hover_bg_strong = var(--rt-button-hover-bg-strong)

// THE HOST FRAME. What the table sits on and is edged by. A standalone build
// takes the lib's own surface, border and overlay shadow; a host sets these
// three to its own ground, rule and shadow so the table reads as part of the
// page around it.
$rt_ground = var(--rt-ground)
$rt_frame_rule = var(--rt-frame-rule)
$rt_frame_shadow = var(--rt-frame-shadow)
$rt_transition = 150ms ease

// Layering. Every floating surface this lib renders draws its z-index from one
// of these, and each is an offset from a single --rt-z-base so a consumer can
// relocate the WHOLE lib into its own stacking scale with one declaration
// rather than fighting seven separate numbers.
//
// The band is deliberately six units wide. A lib that squats on a wide range of
// absolute values (this one used 1000 through 10000) forces the host app to
// work around it; a tight band slots into any gap the host has spare.
//
// The default base of 1000 puts the entire lib BELOW MUI's modal layer (1300),
// which is the safe default: a host's own dialogs cover the table rather than
// the other way round. A host that wants the table modal above its chrome sets
// --rt-z-base and gets the internal ordering for free.
//
// Ordering rule, learned the hard way: a surface that is only ever opened FROM
// another surface belongs ABOVE everything that can open it. That is why
// --rt-z-popper is the top rung and not one beside --rt-z-modal — poppers open
// from inside the view modal, and at 1299 against a modal at 10000 they were
// rendering behind their own host.
$rt_z_base = 1000
$rt_z_menu = 1001
$rt_z_control = 1002
$rt_z_overlay = 1003
$rt_z_panel = 1004
$rt_z_modal = 1005
$rt_z_popper = 1006

// Runtime CSS custom properties — consumers override these.
//
// Wrapped in :where() so the whole block carries ZERO specificity, which is
// what makes "consumers override these" true rather than aspirational. This lib
// ships its CSS through style-loader, so its stylesheet is injected into head at
// runtime and its position relative to the host's own stylesheet is an accident
// of module evaluation order. A plain `:root` here ties a consumer's `:root`
// on specificity (0,1,0 each), so the winner would be decided by that accident —
// and when the lib happened to be injected last, the consumer's override
// silently did nothing. At zero specificity any consumer declaration wins
// outright, whatever the order.
//
// Keep the :where(). Unwrapping it re-arms that coin flip for every token.
:where(:root)
  --rt-ground var(--rt-bg)
  --rt-frame-rule var(--rt-border-subtle)
  --rt-frame-shadow var(--rt-shadow-overlay)
  --rt-border rgba(15, 23, 42, 0.14)
  --rt-border-subtle #e6e8eb
  --rt-divider #eef0f2
  --rt-bg #ffffff
  --rt-bg-subtle #f7f8f9
  --rt-bg-hover rgba(15, 23, 42, 0.04)
  --rt-bg-hover-strong #eceff2
  --rt-bg-selected rgba(15, 23, 42, 0.06)
  --rt-bg-overlay rgba(15, 23, 42, 0.45)
  --rt-text #1f2328
  --rt-text-muted #57606a
  --rt-text-subtle #6e7781
  --rt-text-disabled #9aa0a6
  --rt-accent #1f6feb
  --rt-accent-strong #1158c7
  --rt-accent-subtle rgba(31, 111, 235, 0.10)
  --rt-accent-text #0a59c9
  --rt-success #1f883d
  --rt-success-strong #186a2e
  --rt-success-bg #2da44e
  --rt-active-bg rgba(31, 111, 235, 0.08)
  --rt-active-bar #1f6feb
  --rt-destructive #d1242f
  --rt-destructive-subtle rgba(209, 36, 47, 0.10)
  --rt-destructive-strong #b51e26
  // The pole black-ink washes and shadows are cut from, and the slate the
  // defaults above use for theirs. A dark host inverts the pole.
  --rt-contrast-pole #000000
  --rt-shade #0f172a
  // Text and icons on a solid accent, success or destructive fill.
  --rt-on-fill #ffffff
  // The view controller's selection blue, and its caution amber.
  --rt-selection #1976d2
  --rt-caution #d99100
  --rt-caution-strong #b87600
  // A remove control's hover.
  --rt-remove #c0392b
  // The table menu's ink, and the table-state chips.
  --rt-menu-ink #37352f
  --rt-state-chip #2383e2
  // Cell states: a sorted column's wash, a hovered cell, a hovered resizer.
  --rt-sorted-bg rgba(255, 255, 204, 0.6)
  --rt-cell-hover #b9d4ff
  --rt-resizer-hover #8ecae6
  // The action buttons under the table: discard, and show-plot's info blue.
  --rt-button-bg #f6f8fa
  --rt-button-border #d0d7e0
  --rt-info-bg #e6f7ff
  --rt-info-text #0e67b2
  --rt-info-border #90caf9
  // Column-param filter controls and preset chips.
  --rt-control-bg #f0f0f0
  --rt-control-border #e0e0e0
  --rt-chip-border #d0d7de
  --rt-chip-selected #2563eb
  --rt-label-text #4b5563
  --rt-radius-sm 4px
  --rt-radius 6px
  --rt-radius-lg 8px
  --rt-font-size-micro 11px
  --rt-font-size-sm 12px
  --rt-font-size 13px
  --rt-font-size-md 14px
  --rt-font-weight-label 600
  --rt-space-xs 4px
  --rt-space-sm 8px
  --rt-space 12px
  --rt-space-lg 16px
  --rt-space-xl 20px
  --rt-row-height 28px
  --rt-row-padding-y 6px
  --rt-focus-ring 0 0 0 2px rgba(31, 111, 235, 0.25)
  --rt-shadow-overlay 0 12px 32px rgba(15, 23, 42, 0.12), 0 2px 6px rgba(15, 23, 42, 0.08)
  --rt-modal-border rgba(0, 0, 0, 0.23)
  --rt-modal-shadow #D0D0D0 4px 4px 0px 0px
  --rt-button-hover-bg #f0f0f0
  --rt-button-hover-bg-strong #b3b3b3
  --rt-transition 150ms ease

  // Layering — see the Stylus block above for the contract. Override
  // --rt-z-base alone to move the whole lib; the offsets follow.
  //
  // Note these MUST be read as var(--rt-z-*) in component sources, never via
  // the Stylus mirror, or a consumer's override cannot reach them. That is the
  // one place this lib's usual "prefer the Stylus mirror" advice is inverted.
  // Note also that --rt-z-base has to be overridden at :root, the same element
  // these are declared on — a calc() in a custom property substitutes where it
  // is DECLARED, so rebasing on a descendant scope silently does nothing.
  --rt-z-base 1000
  --rt-z-menu calc(var(--rt-z-base) + 1)
  --rt-z-control calc(var(--rt-z-base) + 2)
  --rt-z-overlay calc(var(--rt-z-base) + 3)
  --rt-z-panel calc(var(--rt-z-base) + 4)
  --rt-z-modal calc(var(--rt-z-base) + 5)
  --rt-z-popper calc(var(--rt-z-base) + 6)
